<config>
	
	<append xpath="/buffs/buff[@name='buffStatusCheck02']">
        <effect_group>
            <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$RoughResist" operation="set" value="1">
                <requirement name="WornItems" operation="Equals" value="1" tags="feet"/>
            </triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$RoughResist" operation="set" value="0">
                <requirement name="WornItems" operation="LT" value="1" tags="feet"/>
            </triggered_effect>
        </effect_group>
    </append>
	
	<append xpath="/buffs">
		
		<!-- ===================================== -->
		<!-- TERRAIN SNOW -->
		<buff name="buffDeepSnowStatus" hidden="true">
			<stack_type value="replace"/>
			<duration value="2"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffDestroyedStoneStatus,buffRoughGroundStatus,buffDesertGroundStatus,buffSandStatus,BuffGravelBonus,BuffConcreteBonus,BuffAsphaltBonus"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffDeepSnowBase">
					<requirement name="CVarCompare" cvar="$terSnowResist" operation="Equals" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffDeepSnowResist">
					<requirement name="CVarCompare" cvar="$terSnowResist" operation="Equals" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffDeepSnowBase">
					<requirement name="CVarCompare" cvar="$terSnowResist" operation="Equals" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffDeepSnowResist">
					<requirement name="CVarCompare" cvar="$terSnowResist" operation="Equals" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveBuff" buff="buffDeepSnowBase">
					<requirement name="HasBuff" buff="buffDeepSnowBase"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveBuff" buff="buffDeepSnowResist">
					<requirement name="HasBuff" buff="buffDeepSnowResist"/>
				</triggered_effect>
			</effect_group>
		</buff>
		
		<buff name="buffDeepSnowBase" name_key="buffDeepSnowBaseName" tooltip_key="buffDeepSnowBaseTooltip" description_key="buffDeepSnowBaseIncDesc" icon="ui_game_symbol_agility" icon_color="255,160,50">
			<stack_type value="replace"/>
			<duration value="2"/>
			<display_value_key value="buffDeepSnowKey"/>
			<display_value value="xxx"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffDeepSnowResist"/>
			</effect_group>
			
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-.25"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-.50"/>
				<passive_effect name="JumpStrength" operation="perc_add" value="-.25"/>
				<passive_effect name="StaminaLoss" operation="perc_add" value=".25" tags="jumping"/>
			</effect_group>
		</buff>
		
		<buff name="buffDeepSnowResist" name_key="buffDeepSnowResistName" tooltip_key="buffDeepSnowResistTooltip" description_key="buffDeepSnowResistIncDesc" icon="ui_game_symbol_agility" icon_color="255,230,40">
			<stack_type value="replace"/>
			<duration value="2"/>
			<display_value_key value="buffDeepSnowKey"/>
			<display_value value="xxx"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffDeepSnowBase"/>
			</effect_group>
			
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-.1"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-.2"/>
				<passive_effect name="JumpStrength" operation="perc_add" value="-.1"/>
			</effect_group>
		</buff>
		
