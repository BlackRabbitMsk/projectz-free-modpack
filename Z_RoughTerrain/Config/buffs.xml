		</buff>
		
		<!-- ===================================== -->
		<!-- TERRAIN DESERT GROUND -->
		<buff name="buffDesertGroundStatus" hidden="true">
			<stack_type value="replace"/>
			<duration value="2"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffDestroyedStoneStatus,buffRoughGroundStatus,buffSandStatus,buffDeepSnowStatus,BuffGravelBonus,BuffConcreteBonus,BuffAsphaltBonus"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffDesertGroundBase">
