				<passive_effect name="RunSpeed" operation="perc_add" value="-.15"/>
			</effect_group>
		</buff>
		
		<!-- Leg puncture -->
		<buff name="BuffLegPunctute" name_key="BuffLegPunctuteName" tooltip_key="BuffLegPunctuteTooltip" description_key="BuffLegPunctuteIncDesc" icon="ui_game_symbol_splint" icon_color="255,20,0" icon_blink="true">
			<damage_type value="bloodloss"/>
			<damage_source value="Internal"/>
			<stack_type value="replace"/>
			<duration value="5"/>
			<update_rate value="1"/>
			<display_value value=".BuffLegPunctute"/>
			<display_value_format value="time"/>
			
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_subtract" value="2"/>
				<passive_effect name="Mobility" operation="base_add" value="-.25"/>
			</effect_group>
			<effect_group name="Timer">
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".BuffLegPunctute" operation="set" value="5"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".BuffLegPunctute" operation="subtract" value="1"/>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar=".BuffLegPunctute"/>
			</effect_group>
		</buff>
    
		<!-- ===================================== -->
		<!-- TERRAIN GRAVEL -->
