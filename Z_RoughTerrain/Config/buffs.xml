				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffRoughGroundBase">
					<requirement name="CVarCompare" cvar="$RoughResist" operation="Equals" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffRoughGroundBase">
