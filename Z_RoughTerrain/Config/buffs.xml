				<passive_effect name="JumpStrength" operation="perc_add" value="-.2"/>
				<passive_effect name="StaminaLoss" operation="perc_add" value=".1" tags="jumping"/>
			</effect_group>
		</buff>
		
		<buff name="buffTerSandResist" name_key="buffTerSandResistName" tooltip_key="buffTerSandResistTooltip" description_key="buffTerSandResistIncDesc" icon="ui_game_symbol_agility" icon_color="255,230,40">
			<stack_type value="replace"/>
