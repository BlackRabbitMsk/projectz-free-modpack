		<buff name="buffDesertGroundBase" name_key="buffDesertGroundBaseName" tooltip_key="buffDesertGroundBaseTooltip" description_key="buffDesertGroundBaseIncDesc" icon="ui_game_symbol_agility" icon_color="255,160,50">
			<stack_type value="replace"/>
