		<!-- ===================================== -->
		<!-- TERRAIN DESTRIOD STONE -->		
		<buff name="buffDestroyedStoneStatus" hidden="true">
			<stack_type value="replace"/>
			<duration value="2"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffRoughGroundStatus,buffDesertGroundStatus,buffSandStatus,buffDeepSnowStatus,BuffGravelBonus,BuffConcreteBonus,BuffAsphaltBonus"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffDestroyedStoneBase">
					<requirement name="CVarCompare" cvar="$terDestrResist" operation="Equals" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffDestroyedStoneResist">
					<requirement name="CVarCompare" cvar="$terDestrResist" operation="Equals" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffDestroyedStoneBase">
					<requirement name="CVarCompare" cvar="$terDestrResist" operation="Equals" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffDestroyedStoneResist">
					<requirement name="CVarCompare" cvar="$terDestrResist" operation="Equals" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveBuff" buff="buffDestroyedStoneBase">
					<requirement name="HasBuff" buff="buffDestroyedStoneBase"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveBuff" buff="buffDestroyedStoneResist">
					<requirement name="HasBuff" buff="buffDestroyedStoneResist"/>
				</triggered_effect>
			</effect_group>
		</buff>
		
		<buff name="buffDestroyedStoneBase" name_key="buffDestroyedStoneBaseName" tooltip_key="buffDestroyedStoneBaseTooltip" description_key="buffDestroyedStoneBaseIncDesc" icon="ui_game_symbol_agility" icon_color="255,160,50">
			<stack_type value="replace"/>
			<duration value="2"/>
			<display_value_key value="buffDestroyedStoneKey"/>
			<display_value value="xxx"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffDestroyedStoneResist"/>
				<triggered_effect trigger="onSelfRun" action="AddBuff" buff="BuffLegPunctute">
					<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="25"/>
				</triggered_effect>
			</effect_group>
			
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-.25"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-.25"/>
				<passive_effect name="JumpStrength" operation="perc_add" value="-.15"/>
				<passive_effect name="StaminaLoss" operation="perc_add" value=".5" tags="running"/>
			</effect_group>
		</buff>
		
		<buff name="buffDestroyedStoneResist" name_key="buffDestroyedStoneResistName" tooltip_key="buffDestroyedStoneResistTooltip" description_key="buffDestroyedStoneResistIncDesc" icon="ui_game_symbol_agility" icon_color="255,230,40">
			<stack_type value="replace"/>
			<duration value="2"/>
			<display_value_key value="buffDestroyedStoneKey"/>
			<display_value value="xxx"/>
			
